# =================================================================
# SCREENER DE VALUATION - VARIÁVEIS DE AMBIENTE (VERCEL & LOCAL)
# =================================================================
# Copie este arquivo para .env no ambiente de desenvolvimento local
# e configure estas mesmas variáveis no painel da Vercel (Settings -> Environment Variables).

# -----------------------------------------------------------------
# 1. SEGURANÇA E ACESSO AO SITE
# -----------------------------------------------------------------
# Senha de proteção de acesso simples ao Screener (ex: minhaSenhaForte123)
SITE_PASSWORD=

# Segredo de autenticação para a rota agendada do Vercel Cron (/api/cron)
# O Vercel Cron envia este valor no header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# -----------------------------------------------------------------
# 2. CHAVES DE API DE DADOS DE MERCADO (NUNCA EXPOSTAS AO NAVEGADOR)
# -----------------------------------------------------------------
# API B3 (brapi.dev) - Obtenha seu token gratuito em: https://brapi.dev/dashboard
BRAPI_API_KEY=

# API EUA (Financial Modeling Prep) - Obtenha em: https://site.financialmodelingprep.com/developer
FMP_API_KEY=

# -----------------------------------------------------------------
# 3. ARMAZENAMENTO EXTERNO (Vercel Serverless não grava em disco)
# Escolha UMA das opções abaixo para persistir cotações, rankings e watchlist:
# -----------------------------------------------------------------

# OPÇÃO A: Upstash Redis / Vercel KV (Recomendado para Serverless - Grátis)
# Crie um banco grátis em https://upstash.com ou adicione a integração "Upstash Redis" na Vercel:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPÇÃO B: Supabase (PostgreSQL via REST - Grátis)
# Crie um projeto em https://supabase.com:
SUPABASE_URL=
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------
# 4. AMBIENTE
# -----------------------------------------------------------------
NODE_ENV=production
