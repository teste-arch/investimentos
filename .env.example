# =================================================================
# SCREENER DE VALUATION - VARIÁVEIS DE AMBIENTE (VERCEL & LOCAL)
# =================================================================
# Na Vercel, as variáveis do Supabase já são criadas automaticamente pela integração.
# Você só precisa cadastrar manualmente: SITE_PASSWORD, CRON_SECRET e as chaves de API.

# -----------------------------------------------------------------
# 1. SEGURANÇA E ACESSO AO SITE
# -----------------------------------------------------------------
# Senha de proteção simples para acesso ao Screener (ex: suaSenhaSegura123)
SITE_PASSWORD=

# Segredo de autenticação para a rota agendada do Vercel Cron (/api/cron)
# O Vercel Cron envia este valor no header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# -----------------------------------------------------------------
# 2. CHAVES DE API DE DADOS DE MERCADO (NUNCA EXPOSTAS AO NAVEGADOR)
# -----------------------------------------------------------------
# API B3 (brapi.dev) - Obtenha seu token gratuito em: https://brapi.dev/dashboard
BRAPI_API_KEY=

# API EUA (Financial Modeling Prep) - Obtenha em: https://site.financialmodelingprep.com/developer
FMP_API_KEY=

# -----------------------------------------------------------------
# 3. SUPABASE (ARMAZENAMENTO DO CACHE)
# Estas variáveis já são preenchidas automaticamente pela integração da Vercel:
# -----------------------------------------------------------------
# URL do projeto Supabase (injetada pela integração da Vercel):
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Chave secreta de serviço que bypassa RLS no backend (injetada pela integração da Vercel):
SUPABASE_SECRET_KEY=

# Chave pública anon (opcional, fallback):
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------
# 4. AMBIENTE
# -----------------------------------------------------------------
NODE_ENV=production
